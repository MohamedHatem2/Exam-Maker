        "jsCode": "const body = $('Webhook').first().json.body || $('Webhook').first().json;\nconst wantId = String(body.id || '').trim();\nif (!wantId) {\n  return [{ json: { error: 'missing id' } }];\n}\n\nconst rows = $input.all().map(i => i.json);\nconst row = rows.find(r => String(r.id || '').trim() === wantId);\n\nif (!row) {\n  return [{ json: { error: 'not_found', id: wantId } }];\n}\n\nlet exam;\ntry {\n  exam = typeof row.json === 'string' ? JSON.parse(row.json) : row.json;\n} catch (e) {\n  return [{ json: { error: 'bad_json' } }];\n}\n\nreturn [{\n  json: {\n    title: exam.title || row.title || 'Exam',\n    questions: exam.questions || [],\n    lang: exam.lang || row.lang || 'ar'\n  }\n}];"
